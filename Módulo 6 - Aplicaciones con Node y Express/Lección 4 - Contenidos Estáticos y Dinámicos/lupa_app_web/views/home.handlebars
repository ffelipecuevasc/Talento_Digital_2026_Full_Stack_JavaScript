<div class="text-center mb-8">
    <h2 class="text-4xl font-bold text-gray-800 mb-2">{{tiendaInfo.nombre}}</h2>
    <p class="text-lg text-gray-600">{{tiendaInfo.bienvenida}}</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    {{#each productos}}
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <img src="{{this.imagen}}" alt="{{this.nombre}}" class="w-full h-48 object-cover">
            <div class="p-4">
                <h3 class="text-xl font-semibold text-gray-800">{{this.nombre}}</h3>
                <p class="text-indigo-600 font-bold mt-2">${{this.precio}}</p>

                <div class="mt-4">
                    {{#if this.disponible}}
                        <span class="bg-green-100 text-green-800 text-sm font-medium px-2.5 py-0.5 rounded">En stock</span>
                    {{else}}
                        <span class="bg-red-100 text-red-800 text-sm font-medium px-2.5 py-0.5 rounded">Agotado</span>
                    {{/if}}
                </div>
            </div>
        </div>
    {{/each}}
</div>